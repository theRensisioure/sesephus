{
  "v": "1.0p",
  "product": "fuzzy-mirror",
  "generator": "fzf-argv",
  "forbidden_ports": [3000, 5000, 3001, 5173, 8000],
  "forbidden_types": ["RegisterClient", "TimeSync", "AlarmTrigger", "LocalRecordStatus"],
  "commands": [
    {
      "id": "schema",
      "argv": ["schema"],
      "view": "plain",
      "flags": []
    },
    {
      "id": "status",
      "argv": ["status"],
      "view": "status",
      "flags": []
    },
    {
      "id": "host",
      "argv": ["host"],
      "view": "host",
      "flags": [
        {"name": "listen", "type": "url", "default": null, "defaults_by_os": {"linux": "unix://$FM_HOME/host.sock", "windows": "tcp://127.0.0.1:18733"}},
        {"name": "token-file", "type": "path", "default": null}
      ]
    },
    {
      "id": "walk",
      "argv": ["walk"],
      "view": "plain",
      "flags": [
        {"name": "root", "type": "path", "default": "$PWD"},
        {"name": "profile", "type": "enum", "values": ["baseline", "advanced"], "default": "baseline"},
        {"name": "or-staged", "type": "bool", "default": false},
        {"name": "refresh", "type": "bool", "default": false},
        {"name": "allow-root-ignore", "type": "bool", "default": false},
        {"name": "ignore-file", "type": "path", "default": null},
        {"name": "max-entries", "type": "int", "default": 50000},
        {"name": "timeout-sec", "type": "int", "default": 30},
        {"name": "max-depth", "type": "int", "default": null},
        {"name": "endpoint", "type": "url", "default": null}
      ]
    },
    {
      "id": "pick",
      "argv": ["pick"],
      "view": "picker",
      "flags": [
        {"name": "root", "type": "path", "default": "$PWD"},
        {"name": "profile", "type": "enum", "values": ["baseline", "advanced"], "default": "baseline"},
        {"name": "or-staged", "type": "bool", "default": false},
        {"name": "refresh", "type": "bool", "default": false},
        {"name": "allow-root-ignore", "type": "bool", "default": false},
        {"name": "ignore-file", "type": "path", "default": null},
        {"name": "max-entries", "type": "int", "default": 50000},
        {"name": "timeout-sec", "type": "int", "default": 30},
        {"name": "max-depth", "type": "int", "default": null},
        {"name": "endpoint", "type": "url", "default": null},
        {"name": "no-walk", "type": "bool", "default": false}
      ]
    },
    {
      "id": "handoff",
      "argv": ["handoff", "show"],
      "view": "plain",
      "flags": []
    },
    {
      "id": "strikes",
      "argv": ["strikes"],
      "view": "plain",
      "flags": [
        {"name": "transcript", "type": "path", "default": null}
      ]
    }
  ],
  "keymap": [
    {"chord": "bspace", "action": "backward-delete-char", "fzf": "backward-delete-char"},
    {"chord": "ctrl-h", "action": "backward-delete-char", "fzf": "backward-delete-char"},
    {"chord": "ctrl-w", "action": "unix-word-rubout", "fzf": "unix-word-rubout"},
    {"chord": "ctrl-u", "action": "unix-line-discard", "fzf": "unix-line-discard"},
    {"chord": "ctrl-r", "action": "clear-query", "fzf": "clear-query"},
    {"chord": "home", "action": "beginning-of-line", "fzf": "beginning-of-line"},
    {"chord": "end", "action": "end-of-line", "fzf": "end-of-line"},
    {"chord": "ctrl-a", "action": "toggle-advanced", "fzf": "execute-silent(fm-internal toggle-advanced)+reload(fm-internal cat-snapshot)"},
    {"chord": "down", "action": "next-row", "fzf": "down"},
    {"chord": "ctrl-n", "action": "next-row", "fzf": "down"},
    {"chord": "ctrl-j", "action": "next-row", "fzf": "down"},
    {"chord": "up", "action": "prev-row", "fzf": "up"},
    {"chord": "ctrl-p", "action": "prev-row", "fzf": "up"},
    {"chord": "ctrl-k", "action": "prev-row", "fzf": "up"},
    {"chord": "pgdn", "action": "page-down", "fzf": "page-down"},
    {"chord": "pgup", "action": "page-up", "fzf": "page-up"},
    {"chord": "enter", "action": "accept", "fzf": "accept"},
    {"chord": "esc", "action": "abort", "fzf": "abort"},
    {"chord": "ctrl-c", "action": "abort", "fzf": "abort"},
    {"chord": "ctrl-g", "action": "abort", "fzf": "abort"},
    {"chord": "ctrl-q", "action": "abort", "fzf": "abort"},
    {"chord": "ctrl-x", "action": "ignore-highlighted", "fzf": "execute-silent(fm-internal ignore-current)+reload(fm-internal cat-snapshot)"},
    {"chord": "ctrl-y", "action": "unignore-last", "fzf": "execute-silent(fm-internal unignore-last)+reload(fm-internal cat-snapshot)"},
    {"chord": "ctrl-d", "action": "identity-noop", "fzf": "ignore"},
    {"chord": "ctrl-f", "action": "files-profile-not-fzd", "fzf": "transform-header(fm-internal banner files-profile-not-fzd)"},
    {"chord": "ctrl-l", "action": "redraw", "fzf": "clear-screen"}
  ],
  "error_classes": [
    {"class": "empty", "emitter": "snapshot", "banner": "walk complete; zero directories after ignores", "picker": "header"},
    {"class": "partial", "emitter": "snapshot", "banner": "partial walk: denied=N seen=M entries_cap=… timeout=…; refresh to retry", "picker": "header"},
    {"class": "permission", "emitter": "walk", "banner": "permission denied at root PATH", "picker": "none"},
    {"class": "cache", "emitter": "snapshot", "banner": "cached snapshot from TIME; not a live walk", "picker": "header"},
    {"class": "cache-miss", "emitter": "walk", "banner": "no snapshot; run walk", "picker": "none"},
    {"class": "disconnected", "emitter": "pair", "banner": "host disconnected; last snapshot not this walk", "picker": "none"},
    {"class": "failed-walk", "emitter": "walk", "banner": "walk failed: DETAIL", "picker": "none"},
    {"class": "unpaired", "emitter": "pair", "banner": "client unpaired; copy token and connect", "picker": "none"},
    {"class": "pending-approval", "emitter": "pair", "banner": "device DEVICE waiting host approve", "picker": "none"},
    {"class": "bad-token", "emitter": "pair", "banner": "pairing token rejected; rotate or recopy", "picker": "none"},
    {"class": "ignore-hid-tree", "emitter": "walk", "when": "R tripped, no --allow-root-ignore", "banner": "ignore pattern P would hide root PATH; refused", "picker": "none"},
    {"class": "ignore-hid-tree", "emitter": "snapshot", "when": "R tripped, --allow-root-ignore", "banner": "ignore pattern P would have hidden root PATH; allowed", "picker": "header"},
    {"class": "query-mismatch", "emitter": "picker", "banner": "query matched nothing in N dirs", "picker": "transform-header"},
    {"class": "not-a-git-work-tree", "emitter": "walk", "banner": "not a git work tree", "picker": "none"},
    {"class": "version-mismatch", "emitter": "pair", "banner": "protocol version mismatch", "picker": "none"},
    {"class": "files-profile-not-fzd", "emitter": "picker", "banner": "files profile is not FZD; dirs only", "picker": "transform-header"},
    {"class": "absent", "emitter": "cli", "banner": "strikes enumerator is absent", "picker": "none"}
  ]
}
