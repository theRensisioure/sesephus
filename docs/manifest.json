    },
    {
      "name": "Host Daemon",
      "path": "core/sesephus/src/host.zig",
      "type": "Zig",
      "description": "One binary, sesefus.exe --role host: encrypted vault, alarms, client coordination, TCP 5000 and HTTP 3000."
    },
    {
      "name": "Python AI Bridge",
