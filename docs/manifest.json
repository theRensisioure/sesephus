{
  "project": "Sesephus",
  "description": "Public lineage/reference repository: retained alarms, vault, bridge, Glass, and historical capture code. Supported Voice capture is external Desktop Clippers (see docs/CANON.md section 5).",
  "modules": [
    {
      "name": "Circadia (alarms)",
