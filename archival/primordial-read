## Code Examples

### 1. Scheduling a Journaling Alarm
The following Zig code showcases how to initialize the scheduler and queue up a behavioral therapy checkpoint:

```zig
const std = @import("std");
const alarm = @import("aura_alarm.zig");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // Initialize the scheduler
    var scheduler = alarm.Scheduler.init(allocator);
    defer scheduler.deinit();

    // Schedule a CBT thought diary reminder for 1 hour from now
    const now = std.time.timestamp();
    const target_time = now + 3600; // +1 hour

    try scheduler.scheduleAlarm(.{
        .id = 101,
        .timestamp = target_time,
        .therapy_type = .cbt_thought_diary,
        .voice_prompt_id = 42,
    });

    std.log.info("Therapeutic checkpoint scheduled successfully.", .{});
}
```

### 2. Low-Latency Audio Recording Hook
This callback implementation avoids dynamic heap allocations by using a pre-allocated ring buffer:

```zig
const std = @import("std");
const AudioCallbackError = error{ BufferOverflow };

pub const AudioEngine = struct {
    ring_buffer: []f32,
    write_idx: usize,
    mutex: std.Thread.Mutex,

    pub fn audioInputCallback(self: *AudioEngine, input_samples: []const f32) AudioCallbackError!void {
        self.mutex.lock();
        defer self.mutex.unlock();

        if (self.write_idx + input_samples.len > self.ring_buffer.len) {
            return AudioCallbackError.BufferOverflow;
        }

        // Copy incoming PCM samples directly to the pre-allocated ring buffer
        @memcpy(self.ring_buffer[self.write_idx..][0..input_samples.len], input_samples);
        self.write_idx += input_samples.len;
    }
};
```

