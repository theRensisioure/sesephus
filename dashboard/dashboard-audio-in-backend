use std::sync::Arc;
use axum::{routing, Router};
use tower_http::cors::{CorsLayer, Any};

mod models;
mod nats;
mod state;
mod api;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    println!("🌐 Aether Dashboard Core starting...");

    // Initialize NATS client
    let mut manager = state::StateManager::new();

    match tokio::time::timeout(
        std::time::Duration::from_secs(5),
        manager.init_nats()
    ).await {
        Ok(_) => println!("✅ NATS connected"),
        Err(_) | Err(e) => {
            eprintln!("⚠️  NATS not available (running locally without NATS): {}", e);
        }
    };

    let app_state = Arc::new(manager.app_state);

    // Health endpoint
    let health = routing::get(|_| "Aether Dashboard Core - Running");

    // Task endpoints
    let tasks = [
        routing::get(api::get_tasks),
        routing::post(api::create_task),
        routing::post::<String, f32>(api::update_task_progress),
    ];

    // Artifact endpoint
    let artifacts = routing::get(api::get_artifacts);

    // Build routes
    let app = Router::new()
        .route("/health", health)
        .nest("/tasks", tasks.into_router())
        .route("/artifacts", artifacts)
        .layer(CorsLayer::permissive());

    println!("📡 API server starting on http://0.0.0.0:8081");

    let listener = tokio::net::TcpListener::bind("0.0.0.0:8081").await?;
    axum::serve(listener, app).await?;

    println!("🎯 Listening for NATS messages on aether.monitoring.*");
    Ok(())
}
