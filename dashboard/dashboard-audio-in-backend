use super::{models, nats};
use serde_json::json;

pub struct StateManager {
    pub app_state: models::AppState,
    pub nats_client: Option<nats::NatsClient>,
}

impl StateManager {
    pub fn new() -> Self {
        Self {
            app_state: models::AppState::default(),
            nats_client: None,
        }
    }

    pub async fn init_nats(&mut self) -> Result<(), nats::NatSError> {
        let client = nats::NatsClient::new()?;

        // Create stream for NATS JetStream
        client.create_or_update_stream("aether.monitoring").await?;

        // Subscribe to agent status updates
        client.subscribe_with_handler(
            "aether.monitoring.agent_status",
            |msg| {
                let payload: models::AgentStatus = serde_json::from_str(&String::from_utf8_lossy(&msg.data)).unwrap();
                self.app_state.agent_statuses.lock().push(payload);

                // Persist to JetStream for audit trail
                let _ = client.store_message("aether.monitoring.agent_status", &msg.data).await;
            }
        ).await;

        self.nats_client = Some(client);
    }

    pub fn add_task(&self, task: models::TaskEntry) {
        self.app_state.tasks.write().push(task);
    }

    pub async fn get_all_tasks(&self) -> Vec<models::TaskEntry> {
        self.app_state.tasks.read().clone()
    }

    pub fn add_artifact(&self, artifact: models::ArtifactEntry) {
        self.app_state.artifacts.lock().push(artifact);
    }

    pub async fn get_all_artifacts(&self) -> Vec<models::ArtifactEntry> {
        self.app_state.artifacts.lock().clone()
    }

    pub async fn publish_agent_status(&self, status: &models::AgentStatus) {
        if let Some(ref client) = self.nats_client {
            let payload = serde_json::to_string(status).unwrap();
            let _ = client.store_message("aether.monitoring.agent_status", payload.as_bytes()).await;
        }
    }

    pub async fn get_agent_statuses(&self) -> Vec<models::AgentStatus> {
        self.app_state.agent_statuses.lock().clone()
    }
}
