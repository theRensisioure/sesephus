use async_nats::{Connect, jetstream};
use serde::{Serialize, Deserialize};
use thiserror::Error;

#[derive(Error, Debug)]
pub enum NatSError {
    #[error("NATS connection failed: {0}")]
    Connect(String),
    #[error("Message publish failed: {0}")]
    Publish(#[from] async_nats::Error),
    #[error("JetStream stream not found")]
    StreamNotFound,
}

pub struct NatsClient {
    nc: Connect,
    js: jetstream::Context,
}

impl NatsClient {
    pub fn new() -> Result<Self, NatSError> {
        let nc = Connect::connect("nats://localhost:4222").map_err(|e| NatSError::Connect(e.to_string()))?;
        Ok(Self {
            nc,
            js: jetstream!(&nc),
        })
    }

    pub async fn publish(&self, subject: &str, message: &[u8]) -> Result<(), NatSError> {
        self.nc.publish(subject.into(), message.to_vec()).await?;
        Ok(())
    }

    pub async fn subscribe(&self, subject: &str) -> nats::Subscriber {
        self.nc.subscribe(subject).await.unwrap()
    }

    pub async fn subscribe_with_handler<F>(&self, subject: &str, handler: F)
    where F: Fn(nats::Message) + Send + Sync + 'static {
        let sub = self.subscribe(subject).await;
        tokio::spawn(async move {
            while let Ok(msg) = sub.next().await {
                handler(msg);
            }
        });
    }

    pub async fn create_or_update_stream(&self, name: &str) -> Result<(), NatSError> {
        self.js.add_stream(
            async_nats::jetstream::stream::Config {
                name: name.to_string(),
                subjects: vec!["aether.monitoring.>".to_string()],
                ..Default::default()
            }
        ).await?;
        Ok(())
    }

    pub async fn store_message(&self, subject: &str, message: &[u8]) -> Result<(), NatSError> {
        self.js.publish(subject.into(), message.to_vec()).await?;
        Ok(())
    }
}
