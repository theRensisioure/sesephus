use axum::{
    extract::State,
    routing::{get, post},
    Json, Router,
};
use serde_json::{json, Value};

pub async fn health(State(state): State<Arc<AppState>>) -> &'static str {
    "Aether Dashboard Core - Running"
}

pub async fn get_tasks(
    State(state): State<Arc<AppState>>,
) -> Json<Vec<models::TaskEntry>> {
    let tasks = state.get_all_tasks().await;
    Json(tasks)
}

pub async fn create_task(
    State(state): State<Arc<AppState>>,
    task: Json<Value>,
) -> Json<models::TaskEntry> {
    let name: String = task["name"].as_str().unwrap_or("").to_string();
    let id = models::generate_task_id();

    let entry = models::TaskEntry {
        id,
        name: name.clone(),
        status: models::TaskStatus::Pending,
        progress: 0.0,
        created_at: chrono::Utc::now(),
        updated_at: chrono::Utc::now(),
    };

    state.add_task(entry.clone());
    Json(entry)
}

pub async fn update_task_progress(
    State(state): State<Arc<AppState>>,
    task_id: String,
    progress: f32,
    status: Option<models::TaskStatus>,
) -> Json<Value> {
    let mut tasks = state.app_state.tasks.write().await;

    for (i, t) in tasks.iter_mut().enumerate() {
        if t.id.to_string() == task_id {
            t.progress = progress.min(1.0);
            t.updated_at = chrono::Utc::now();

            if let Some(s) = status {
                t.status = s;
            }

            // Publish via NATS
            if state.nats_client.is_some() {
                let _ = state.publish_agent_status(&models::AgentStatus {
                    node_id: Uuid::new_v4(),
                    agent_name: "TASK_UPDATER".to_string(),
                    is_idle: progress >= 1.0,
                    current_task: Some(format!("{}: {:.1}%", t.name, t.progress * 100.0)),
                    timestamp: chrono::Utc::now(),
                }).await;
            }

            tasks[i] = t.clone();

            return Json(json!({ "success": true, "progress": t.progress, "status": t.status }));
        }
    }

    Json(json!({"error": "Task not found"}))
}

pub async fn get_artifacts(
    State(state): State<Arc<AppState>>,
) -> Json<Vec<models::ArtifactEntry>> {
    let artifacts = state.get_all_artifacts().await;
    Json(artifacts)
}
