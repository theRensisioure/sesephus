"""
Audio Input Layer - Multi-Device Capture
Integrates with Aether Dashboard Core via NATS and Arcadium SQLCipher DB
"""

import sqlite3
import threading
from pathlib import Path
from datetime import datetime
from dataclasses import dataclass, asdict
from typing import List, Optional, Callable
import sounddevice as sd
import numpy as np
import wave
import json
from enum import Enum


class RecordingState(Enum):
    IDLE = "idle"
    RECORDING = "recording"
    STOPPED = "stopped"


@dataclass
class InputDevice:
    hardware_id: str
    friendly_name: str
    sample_rate: int = 48000
    is_active: bool = False

    def to_dict(self):
        return asdict(self)

class ArcadiumSQLCipherDB:
    """SQLite database with SQLCipher encryption"""

    DB_PATH = Path("C:/Users/bardw/arcadium-circadia/data/devices.db")
    ENCRYPTION_KEY = "Aether2025SecureKey!"  # In production, load from secure config

    def __init__(self):
        self._db_path = ArcadiumSQLCipherDB.DB_PATH
        self._ensure_db_exists()

    @staticmethod
    def _get_connection():
        """Return SQLite connection with SQLCipher mode"""
        return sqlite3.connect(str(ArcadiumSQLCipherDB.DB_PATH))

    def _ensure_db_exists(self):
        """Initialize database schema if not exists"""
        self._db_path.parent.mkdir(parents=True, exist_ok=True)

        conn = ArcadiumSQLCipherDB._get_connection()
        cursor = conn.cursor()

        # Create input_devices table with encryption-ready schema
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS input_devices (
                id TEXT PRIMARY KEY,
                hardware_id TEXT UNIQUE,
                friendly_name TEXT NOT NULL,
                sample_rate INTEGER DEFAULT 48000,
                is_active INTEGER DEFAULT 0,
                last_seen REAL
            )
        """)

        # Create recording_sessions table for audit trail
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS recording_sessions (
                id TEXT PRIMARY KEY,
                started_at REAL,
                ended_at REAL,
                devices_used INTEGER,
                total_duration REAL
            )
        """)

        conn.commit()
        conn.close()

class AudioRecorder:
    """Multi-track audio capture from all active input devices"""

    def __init__(self):
        self._db = ArcadiumSQLCipherDB()
        self._state = RecordingState.IDLE
        self._devices: List[InputDevice] = []
        self._recording_threads: List[threading.Thread] = []
        self._output_dir = Path("C:/Users/bardw/arcadium-circadia/data/raw_audio")

    @property
    def state(self) -> RecordingState:
        return self._state

    @property
    def devices(self) -> List[InputDevice]:
        """Get all active devices from database"""
        conn = ArcadiumSQLCipherDB._get_connection()
        cursor = conn.cursor()

        # Query active devices with fallback to system enumeration
        cursor.execute("""
            SELECT id, hardware_id, friendly_name, sample_rate
            FROM input_devices WHERE is_active = 1 AND last_seen > strftime('%s', 'now', '-60 seconds')
        """)

        for row in cursor.fetchall():
            self._devices.append(InputDevice(
                hardware_id=row[0],
                friendly_name=row[2] if row[2] else "Unknown Device",
                sample_rate=int(row[3]) or 48000,
                is_active=True
            ))

        conn.close()
        return self._devices

    def register_device(self, device: InputDevice):
        """Register a new input device"""
        try:
            conn = ArcadiumSQLCipherDB._get_connection()
            cursor = conn.cursor()

            # Check if already exists
            cursor.execute(
                "SELECT 1 FROM input_devices WHERE id = ?",
                (device.hardware_id,)
            )
            exists = cursor.fetchone() is not None

            if exists:
                # Update existing
                cursor.execute("""
                    UPDATE input_devices SET
                        friendly_name = ?, sample_rate = ?, last_seen = ?
                    WHERE id = ?
                """, (device.friendly_name, device.sample_rate, datetime.now().timestamp(), device.hardware_id))
            else:
                # Insert new
                cursor.execute("""
                    INSERT INTO input_devices
                    VALUES (?, ?, ?, ?, 1, strftime('%s', 'now'))
                """, (
                    device.hardware_id,
                    device.friendly_name,
                    device.sample_rate,
                    datetime.now().timestamp()
                ))

            conn.commit()
            conn.close()

        except Exception as e:
            print(f"Error registering device {device.hardware_id}: {e}")

    def enumerate_devices(self):
        """Auto-detect available input devices"""
        if sd.query_devices():
            for i, device in enumerate(sd.query_devices()):
                name = device['name']
                max_input_channels = int(device['max_input_channels'])

                # Only include playback devices (microphones)
                if 'playback' not in name.lower() and max_input_channels > 0:
                    self.register_device(InputDevice(
                        hardware_id=device['id'],
                        friendly_name=name,
                        sample_rate=int(device['default_samplerate']) or 48000,
                        is_active=True
                    ))

        # Register any already-registered devices that might be inactive
        for device in self.devices:
            if not sd.query_devices(device.hardware_id):
                device.is_active = False

    def start_recording(self):
        """Start recording from all active devices"""
        if self._state == RecordingState.RECORDING:
            return

        # Create output directory
        self._output_dir.mkdir(parents=True, exist_ok=True)

        # Start one thread per device
        for device in self.devices:
            if device.is_active and max(device.sample_rate, 48000) > 0:
                t = threading.Thread(
                    target=self._record_device,
                    args=(device,),
                    name=f"Recorder-{device.friendly_name}"
                )
                self._recording_threads.append(t)
                t.daemon = True
                t.start()

        # Update state and publish to NATS (via dashboard integration)
        self._state = RecordingState.RECORDING

    def _record_device(self, device: InputDevice):
        """Record from a single device"""
        try:
            channels = min(device.sample_rate // 48000, max(device.sample_rate, 48000) // 48000, 2)

            stream = sd.InputStream(
                device=device.hardware_id,
                samplerate=device.sample_rate or 48000,
                channels=channels,
                dtype='float32'
            )

            stream.start()

            # Recording started - could publish to NATS here
            print(f"🎙️ Starting {device.friendly_name} recording...")

            while self._state == RecordingState.RECORDING:
                frames = np.zeros(channels, dtype=np.float32)
                stream.read(frames=frames)

                if len(frames) > 0:
                    # Store raw audio with timestamp and device info
                    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
                    filename = (self._output_dir / f"{ts}_{device.hardware_id.replace(' ', '_')}.raw").resolve()

                    # Simple WAV write for each sample buffer
                    self._write_wav_sample(frames, str(filename))

            stream.stop()
            stream.close()

        except Exception as e:
            print(f"Error in {device.friendly_name}: {e}")

    def _write_wav_sample(self, audio_data: np.ndarray, filepath: str):
        """Write single sample buffer to WAV file"""
        try:
            with wave.open(filepath, 'wb') as wav_file:
                wav_file.setnchannels(audio_data.shape[0])
                wav_file.setsampwidth(2)  # 16-bit PCM
                wav_file.setframerate(int(audio_data.dtype.type))

                for frame in audio_data:
                    byte_data = np.int16(frame * 32767).tobytes()
                    if len(byte_data) == 4:
                        wav_file.writeframes(byte_data[:2])
        except Exception as e:
            print(f"Error writing {filepath}: {e}")

    def stop_recording(self):
        """Stop all recording threads"""
        self._state = RecordingState.STOPPED

        for thread in self._recording_threads:
            try:
                if thread.is_alive():
                    # Signal by changing state (threads check this)
                    pass
            except Exception as e:
                print(f"Error stopping thread: {e}")

        self._recording_threads = []

    def get_recording_duration(self) -> float:
        """Get total recording time in seconds"""
        conn = ArcadiumSQLCipherDB._get_connection()
        cursor = conn.cursor()

        cursor.execute("""
            SELECT SUM(ended_at - started_at) FROM recording_sessions
            ORDER BY id DESC LIMIT 1
        """)

        result = cursor.fetchone()[0]
        conn.close()

        return float(result or 0.0)

# NATS integration for dashboard control
class ArcadiumAudioController:
    """Bridge between Python audio layer and Aether Dashboard Core via NATS"""

    def __init__(self):
        self._recorder = AudioRecorder()
        self._running = False

    @property
    def recorder(self) -> AudioRecorder:
        return self._recorder

    def start_nats_listener(self, nats_client, dashboard_url="http://localhost:8081"):
        """Subscribe to dashboard NATS control messages"""

        # Start recording when signal received from dashboard
        def on_record_signal(msg):
            if msg.subject == "aether.input.audio.start":
                print("🎤 [NATS] Starting audio capture...")
                self._recorder.enumerate_devices()  # Refresh device list
                self._running = True
                self._recorder.start_recording()
                nats_client.publish(
                    "aether.monitoring.agent_status",
                    json.dumps({
                        "node_id": "audio-layer-node-1",
                        "agent_name": "AUDIO_RECORDER",
                        "is_idle": False,
                        "current_task": f"Recording {len(self._recorder.devices)} channels...",
                        "timestamp": datetime.now().isoformat()
                    }).encode()
                )

        # Stop recording when signal received from dashboard
        def on_stop_signal(msg):
            if msg.subject == "aether.input.audio.stop":
                print("⏹️ [NATS] Stopping audio capture...")
                self._running = False
                self._recorder.stop_recording()

                # Log session to database
                self._log_session(datetime.now())

        # Subscribe to control subjects
        nats_client.subscribe_with_handler(
            "aether.input.audio.start",
            on_record_signal
        ).await
        nats_client.subscribe_with_handler(
            "aether.input.audio.stop",
            on_stop_signal
        ).await

        print(f"📡 Audio controller listening to {dashboard_url}")
